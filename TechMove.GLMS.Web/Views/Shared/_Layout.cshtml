<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechMove GLMS</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- FontAwesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <!-- Custom Enterprise Design System -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg glms-navbar navbar-dark sticky-top">
            <div class="container-fluid px-4">
                <a class="glms-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <div class="brand-icon">
                        <i class="fa-solid fa-truck-fast"></i>
                    </div>
                    <span>TechMove <span style="font-weight: 300; color: #38bdf8;">GLMS</span></span>
                    <span class="brand-badge d-none d-sm-inline">Enterprise</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#glmsNav" aria-controls="glmsNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="glmsNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="fa-solid fa-chart-pie me-1"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Contracts" asp-action="Index">
                                <i class="fa-solid fa-file-contract me-1"></i> Contracts Hub
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Contracts" asp-action="Create">
                                <i class="fa-solid fa-circle-plus me-1 text-info"></i> Create Contract <span class="badge bg-primary ms-1" style="font-size:0.65rem;">Factory</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="ServiceRequests" asp-action="Index">
                                <i class="fa-solid fa-boxes-packing me-1"></i> Service Requests
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="ServiceRequests" asp-action="Create">
                                <i class="fa-solid fa-bolt me-1 text-warning"></i> Raise Request <span class="badge bg-success ms-1" style="font-size:0.65rem;">Live FX API</span>
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        <div class="text-end text-light d-none d-md-block" style="font-size: 0.82rem;">
                            <span class="text-white-50">Enterprise Region:</span> <strong>Global Multi-Hub</strong>
                        </div>
                        <span class="badge bg-dark border border-secondary text-info px-3 py-2">
                            <i class="fa-solid fa-server me-1"></i> Monolith Prototype (Part 2)
                        </span>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4 py-4">
        <!-- Toast / Alert notifications -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius: 12px; background-color: #ecfdf5; color: #065f46; border-left: 5px solid #10b981 !important;">
                <i class="fa-solid fa-circle-check me-2 text-success"></i>
                <strong>Success:</strong> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="border-radius: 12px; background-color: #fef2f2; color: #991b1b; border-left: 5px solid #ef4444 !important;">
                <i class="fa-solid fa-triangle-exclamation me-2 text-danger"></i>
                <strong>Notice:</strong> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="glms-footer mt-auto">
        <div class="container-fluid px-4">
            <div class="row align-items-center gy-2">
                <div class="col-md-6 text-center text-md-start">
                    &copy; 2026 <strong>TechMove Logistics</strong> • Global Logistics Management System (GLMS)
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <span class="badge bg-light text-secondary border">EAPD7111 / PROG7311 PoE Part 2</span>
                    <span class="badge bg-light text-secondary border ms-1">ASP.NET Core MVC Monolith</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap & jQuery -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
