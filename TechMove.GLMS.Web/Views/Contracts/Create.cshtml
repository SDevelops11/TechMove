@model TechMove.GLMS.Web.ViewModels.CreateContractViewModel
@{
    ViewData["Title"] = "Create Freight Contract (Factory Pattern)";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-2">
                    <i class="fa-solid fa-arrow-left me-1"></i> Back to Contracts Hub
                </a>
                <h2 class="fw-bold text-dark mb-0">
                    <i class="fa-solid fa-file-circle-plus text-primary me-2"></i>Create Freight Agreement
                </h2>
                <small class="text-muted">Instantiated via GoF Factory Pattern with Strict PDF Agreement Archiving</small>
            </div>
            <div>
                <span class="badge bg-primary px-3 py-2">
                    <i class="fa-solid fa-industry me-1"></i> Factory Pattern
                </span>
            </div>
        </div>

        <div class="card border-0 shadow-sm" style="border-radius: 16px;">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Create" method="post" enctype="multipart/form-data" id="createContractForm">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                    <!-- Factory Pattern Selection Banner -->
                    <div class="alert alert-primary d-flex align-items-center mb-4" role="alert" style="border-radius: 12px; background: #eff6ff; border: 1px solid #bfdbfe;">
                        <i class="fa-solid fa-diagram-project fa-2x me-3 text-primary"></i>
                        <div>
                            <strong class="text-primary">GoF Factory Pattern Implementation:</strong>
                            <div class="small text-secondary">
                                The selected Contract Type triggers <code>IContractFactory</code> to instantiate specialized concrete implementations (<code>StandardContract</code>, <code>PremiumContract</code>, <code>InternationalContract</code>, or <code>ExpressContract</code>) with encapsulated SLA parameters and multiplier logic.
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="ClientId" class="form-label fw-bold"></label>
                            <select asp-for="ClientId" asp-items="Model.ClientsList" class="form-select" required>
                                <option value="">-- Choose Logistics Client --</option>
                            </select>
                            <span asp-validation-for="ClientId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ContractType" class="form-label fw-bold"></label>
                            <select asp-for="ContractType" class="form-select" id="contractTypeSelect" required>
                                <option value="Standard">Standard Freight (1.0x Rate Multiplier)</option>
                                <option value="Premium">Premium Priority Freight (1.25x Multiplier, Min 30 Days)</option>
                                <option value="International">International Cross-Border (1.5x Multiplier, Min 60 Days)</option>
                                <option value="Express">Express Air/Road Cargo (1.75x Multiplier, Guaranteed Window)</option>
                            </select>
                            <span asp-validation-for="ContractType" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Title" class="form-label fw-bold"></label>
                            <input asp-for="Title" class="form-control" placeholder="e.g., Annual Durban to City Deep Intermodal Haulage Agreement" required />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="StartDate" class="form-label fw-bold"></label>
                            <input asp-for="StartDate" type="date" class="form-control" required />
                            <span asp-validation-for="StartDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="EndDate" class="form-label fw-bold"></label>
                            <input asp-for="EndDate" type="date" class="form-control" required />
                            <span asp-validation-for="EndDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="BaseValueUsd" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <span class="input-group-text">$ USD</span>
                                <input asp-for="BaseValueUsd" class="form-control" type="number" step="0.01" min="1" required />
                            </div>
                            <span asp-validation-for="BaseValueUsd" class="text-danger small"></span>
                            <small class="text-muted">The factory automatically adjusts estimated contract value based on the chosen tier multiplier.</small>
                        </div>

                        <!-- PDF Signed Agreement File Upload -->
                        <div class="col-12 mt-4">
                            <div class="p-3 border rounded-3" style="background-color: #f8fafc; border: 2px dashed #cbd5e1 !important;">
                                <label asp-for="AgreementPdf" class="form-label fw-bold text-dark d-flex align-items-center justify-content-between">
                                    <span><i class="fa-solid fa-file-pdf text-danger me-2"></i>Signed Legal Agreement (.PDF Required)</span>
                                    <span class="badge bg-danger">Strict PDF Only</span>
                                </label>
                                <input asp-for="AgreementPdf" type="file" class="form-control" accept=".pdf,application/pdf" id="pdfFileInput" />
                                <span asp-validation-for="AgreementPdf" class="text-danger small"></span>
                                <div class="form-text mt-2 small text-muted">
                                    <i class="fa-solid fa-shield-halved text-success me-1"></i>
                                    Security Policy: Files are strictly validated via extension (.pdf), MIME type (<code>application/pdf</code>), and magic bytes (<code>%PDF</code> header verification). Files are renamed using UUIDs to prevent overwrite collisions.
                                </div>
                                <div id="pdfClientAlert" class="mt-2 text-danger small fw-semibold d-none"></div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-glms-primary px-5">
                            <i class="fa-solid fa-check me-1"></i> Create Contract
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Client-side strict validation for PDF uploads
        document.getElementById('pdfFileInput').addEventListener('change', function (e) {
            var file = e.target.files[0];
            var alertBox = document.getElementById('pdfClientAlert');
            alertBox.classList.add('d-none');
            alertBox.textContent = '';

            if (file) {
                var fileName = file.name.toLowerCase();
                if (!fileName.endsWith('.pdf')) {
                    alertBox.textContent = 'Client-Side Validation Error: Only files with a .pdf extension are permitted. Selected: ' + file.name;
                    alertBox.classList.remove('d-none');
                    e.target.value = ''; // clear input
                    return;
                }

                if (file.size > 10 * 1024 * 1024) {
                    alertBox.textContent = 'Client-Side Validation Error: File size exceeds the maximum limit of 10MB.';
                    alertBox.classList.remove('d-none');
                    e.target.value = ''; // clear input
                    return;
                }
            }
        });
    </script>
}
