@model TechMove.GLMS.Web.Models.Contract
@{
    ViewData["Title"] = $"Contract {Model.ContractNumber}";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-2">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Hub
        </a>
        <h2 class="fw-bold text-dark mb-0">
            <i class="fa-solid fa-file-signature text-primary me-2"></i>@Model.ContractNumber
        </h2>
        <span class="text-muted">@Model.Title</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ChangeStatus" asp-route-id="@Model.Id" class="btn btn-outline-primary">
            <i class="fa-solid fa-arrows-rotate me-1"></i> Change Status (Observer Pattern)
        </a>
        @if (Model.Status == TechMove.GLMS.Web.Models.ContractStatus.Active)
        {
            <a asp-controller="ServiceRequests" asp-action="Create" asp-route-contractId="@Model.Id" class="btn btn-glms-success">
                <i class="fa-solid fa-bolt me-1"></i> Raise Service Request
            </a>
        }
    </div>
</div>

<div class="row g-4">
    <!-- Contract Summary Card -->
    <div class="col-lg-8">
        <div class="glass-panel">
            <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-4">
                <div>
                    <h5 class="fw-bold mb-1">Contract Specifications</h5>
                    <small class="text-muted">Instantiated via GoF Factory Pattern (Tier: @Model.ContractType)</small>
                </div>
                <div>
                    @switch (Model.Status)
                    {
                        case TechMove.GLMS.Web.Models.ContractStatus.Active:
                            <span class="badge-status badge-status-active"><i class="fa-solid fa-circle" style="font-size:6px;"></i> Active (Requests Allowed)</span>
                            break;
                        case TechMove.GLMS.Web.Models.ContractStatus.Draft:
                            <span class="badge-status badge-status-draft"><i class="fa-solid fa-circle" style="font-size:6px;"></i> Draft (Awaiting Approval)</span>
                            break;
                        case TechMove.GLMS.Web.Models.ContractStatus.OnHold:
                            <span class="badge-status badge-status-onhold"><i class="fa-solid fa-circle" style="font-size:6px;"></i> On Hold (Requests Blocked)</span>
                            break;
                        case TechMove.GLMS.Web.Models.ContractStatus.Expired:
                            <span class="badge-status badge-status-expired"><i class="fa-solid fa-circle" style="font-size:6px;"></i> Expired (Requests Blocked)</span>
                            break;
                    }
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <small class="text-muted text-uppercase fw-bold" style="font-size:0.75rem;">Client Organization</small>
                    <div class="fw-bold text-dark fs-5">@(Model.Client?.Name ?? "N/A")</div>
                    <small class="text-muted"><i class="fa-solid fa-user me-1"></i>@(Model.Client?.ContactPerson ?? "N/A")</small>
                </div>
                <div class="col-md-6">
                    <small class="text-muted text-uppercase fw-bold" style="font-size:0.75rem;">Region / Hub</small>
                    <div class="fw-semibold text-dark fs-5">@(Model.Client?.Region ?? "Global")</div>
                    <small class="text-muted"><i class="fa-solid fa-envelope me-1"></i>@(Model.Client?.ContactEmail ?? "N/A")</small>
                </div>

                <div class="col-md-3 mt-4">
                    <small class="text-muted text-uppercase fw-bold" style="font-size:0.75rem;">Start Date</small>
                    <div class="fw-bold text-success fs-6"><i class="fa-regular fa-calendar-check me-1"></i>@Model.StartDate.ToString("dd MMM yyyy")</div>
                </div>
                <div class="col-md-3 mt-4">
                    <small class="text-muted text-uppercase fw-bold" style="font-size:0.75rem;">End Date</small>
                    <div class="fw-bold text-danger fs-6"><i class="fa-regular fa-calendar-xmark me-1"></i>@Model.EndDate.ToString("dd MMM yyyy")</div>
                </div>
                <div class="col-md-3 mt-4">
                    <small class="text-muted text-uppercase fw-bold" style="font-size:0.75rem;">Service Level</small>
                    <div><span class="badge-service-level">@Model.ServiceLevel</span></div>
                </div>
                <div class="col-md-3 mt-4">
                    <small class="text-muted text-uppercase fw-bold" style="font-size:0.75rem;">Contract Type</small>
                    <div class="fw-semibold text-dark">@Model.ContractType Tier</div>
                </div>

                <div class="col-md-6 mt-4">
                    <div class="p-3 rounded-3" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                        <small class="text-muted text-uppercase fw-bold" style="font-size:0.72rem;">Estimated Financial Scope (USD)</small>
                        <div class="fs-4 fw-bold text-dark font-monospace">$ @Model.EstimatedValueUsd.ToString("N2")</div>
                    </div>
                </div>
                <div class="col-md-6 mt-4">
                    <div class="p-3 rounded-3" style="background-color: #f0fdf4; border: 1px solid #bbf7d0;">
                        <small class="text-success text-uppercase fw-bold" style="font-size:0.72rem;">Converted Local Valuation (ZAR)</small>
                        <div class="fs-4 fw-bold text-success font-monospace">R @Model.EstimatedValueZar.ToString("N2")</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Associated Service Requests -->
        <div class="glass-panel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Dispatched Service Requests (@Model.ServiceRequests.Count)</h5>
                @if (Model.Status == TechMove.GLMS.Web.Models.ContractStatus.Active)
                {
                    <a asp-controller="ServiceRequests" asp-action="Create" asp-route-contractId="@Model.Id" class="btn btn-sm btn-glms-success">
                        <i class="fa-solid fa-plus me-1"></i> Raise Request
                    </a>
                }
                else
                {
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                        <i class="fa-solid fa-ban me-1"></i> Requests Blocked (Contract @Model.Status)
                    </span>
                }
            </div>

            @if (!Model.ServiceRequests.Any())
            {
                <div class="alert alert-light text-center py-4 border" style="border-radius: 12px;">
                    <i class="fa-solid fa-box-open text-muted fa-2x mb-2 d-block"></i>
                    <span class="text-muted">No service requests currently linked to this contract.</span>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-glms">
                        <thead>
                            <tr>
                                <th>Request #</th>
                                <th>Description</th>
                                <th>Route</th>
                                <th>Foreign Amount</th>
                                <th>ZAR Cost</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sr in Model.ServiceRequests)
                            {
                                <tr>
                                    <td><strong class="text-dark font-monospace">@sr.RequestNumber</strong></td>
                                    <td>@sr.Description</td>
                                    <td><small class="text-muted">@sr.Origin &rarr; @sr.Destination</small></td>
                                    <td>@sr.OriginalCostUsd.ToString("N2") @sr.OriginalCurrency</td>
                                    <td><strong class="text-success font-monospace">R @sr.Cost.ToString("N2")</strong></td>
                                    <td><span class="badge bg-secondary">@sr.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Right Sidebar: PDF Document & Observer Audit Timeline -->
    <div class="col-lg-4">
        <!-- PDF Agreement Card -->
        <div class="glass-panel mb-4">
            <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">
                <i class="fa-solid fa-file-pdf text-danger me-2"></i>Signed Legal Agreement
            </h6>

            @if (!string.IsNullOrWhiteSpace(Model.AgreementFilePath))
            {
                <div class="p-3 rounded-3 text-center mb-3" style="background: #fef2f2; border: 1px dashed #f87171;">
                    <i class="fa-solid fa-file-pdf fa-3x text-danger mb-2"></i>
                    <div class="fw-bold text-truncate" style="max-width: 100%;">@(Model.AgreementFileName ?? "Signed_Agreement.pdf")</div>
                    <small class="text-muted d-block">
                        Uploaded: @(Model.AgreementUploadedAt?.ToString("dd MMM yyyy HH:mm") ?? "N/A")
                    </small>
                    @if (Model.AgreementFileSizeBytes.HasValue)
                    {
                        <small class="badge bg-light text-dark border mt-1">@((Model.AgreementFileSizeBytes.Value / 1024).ToString("N0")) KB</small>
                    }
                </div>

                <a asp-action="DownloadAgreement" asp-route-id="@Model.Id" class="btn btn-danger w-100 fw-semibold">
                    <i class="fa-solid fa-download me-1"></i> Download PDF Document
                </a>
            }
            else
            {
                <div class="alert alert-warning mb-0" style="border-radius: 10px; font-size: 0.85rem;">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i>
                    No signed agreement PDF uploaded for this contract yet.
                </div>
            }
        </div>

        <!-- Observer Pattern Departmental Audit Trail -->
        <div class="glass-panel">
            <div class="d-flex align-items-center justify-content-between border-bottom pb-2 mb-3">
                <h6 class="fw-bold text-dark mb-0">
                    <i class="fa-solid fa-bell text-warning me-2"></i>Observer Pattern Audit Trail
                </h6>
                <span class="badge bg-warning text-dark" style="font-size:0.65rem;">4 Observers</span>
            </div>
            <p class="small text-muted mb-3">
                Status changes notify all 4 subscribed departments: Operations, Finance, Client Services, and Compliance.
            </p>

            @if (!Model.StatusLogs.Any())
            {
                <div class="text-center text-muted small py-3">
                    No status transitions logged yet.
                </div>
            }
            else
            {
                <div class="timeline">
                    @foreach (var log in Model.StatusLogs)
                    {
                        <div class="timeline-item">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="timeline-badge">@log.Department</span>
                                <small class="text-muted" style="font-size: 0.72rem;">@log.Timestamp.ToString("dd MMM HH:mm")</small>
                            </div>
                            <div class="small fw-semibold mt-1">
                                <span class="badge bg-secondary" style="font-size:0.68rem;">@log.OldStatus</span>
                                &rarr;
                                <span class="badge bg-primary" style="font-size:0.68rem;">@log.NewStatus</span>
                            </div>
                            <p class="small text-muted mt-1 mb-0" style="font-size: 0.8rem;">
                                @log.ActionTaken
                            </p>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
