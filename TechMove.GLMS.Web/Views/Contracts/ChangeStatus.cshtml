@model TechMove.GLMS.Web.ViewModels.ChangeContractStatusViewModel
@{
    ViewData["Title"] = $"Update Status - {Model.ContractNumber}";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <a asp-action="Details" asp-route-id="@Model.ContractId" class="btn btn-sm btn-outline-secondary mb-2">
                    <i class="fa-solid fa-arrow-left me-1"></i> Back to Contract
                </a>
                <h2 class="fw-bold text-dark mb-0">
                    <i class="fa-solid fa-arrows-rotate text-primary me-2"></i>Update Contract Lifecycle Status
                </h2>
                <small class="text-muted">Broadcasts real-time events to all 4 GoF Observer Pattern departmental listeners</small>
            </div>
            <div>
                <span class="badge bg-warning text-dark px-3 py-2">
                    <i class="fa-solid fa-bell me-1"></i> Observer Pattern
                </span>
            </div>
        </div>

        <div class="card border-0 shadow-sm" style="border-radius: 16px;">
            <div class="card-body p-4 p-md-5">
                <form asp-action="ChangeStatus" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                    <input type="hidden" asp-for="ContractId" />
                    <input type="hidden" asp-for="ContractNumber" />
                    <input type="hidden" asp-for="ContractTitle" />
                    <input type="hidden" asp-for="CurrentStatus" />

                    <div class="p-3 mb-4 rounded-3" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <strong class="text-dark font-monospace">@Model.ContractNumber</strong>
                                <div class="text-muted small">@Model.ContractTitle</div>
                            </div>
                            <div>
                                <span class="text-muted small me-2">Current Status:</span>
                                <span class="badge bg-secondary">@Model.CurrentStatus</span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewStatus" class="form-label fw-bold"></label>
                        <select asp-for="NewStatus" asp-items="Html.GetEnumSelectList<TechMove.GLMS.Web.Models.ContractStatus>()" class="form-select" required>
                        </select>
                        <span asp-validation-for="NewStatus" class="text-danger small"></span>
                        <div class="form-text small mt-2">
                            <strong>Lifecycle Workflow Rules:</strong>
                            <ul class="mb-0 mt-1 ps-3 text-muted">
                                <li><strong>Active:</strong> Permits raising new Service Requests.</li>
                                <li><strong>On Hold:</strong> Suspends operations; strictly restricts raising new Service Requests.</li>
                                <li><strong>Expired:</strong> Terminal status; blocks all new Service Requests.</li>
                            </ul>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Reason" class="form-label fw-bold"></label>
                        <textarea asp-for="Reason" class="form-control" rows="3" placeholder="Explain the operational rationale for this status change (e.g., Audit review, renewal delay, compliance pause)..."></textarea>
                        <span asp-validation-for="Reason" class="text-danger small"></span>
                    </div>

                    <!-- Observer Dispatch Notice Box -->
                    <div class="alert alert-info d-flex align-items-center mb-4" style="border-radius: 12px;">
                        <i class="fa-solid fa-satellite-dish fa-2x me-3 text-info"></i>
                        <div class="small">
                            <strong>Automated Inter-Departmental Notification:</strong>
                            Submitting this form triggers <code>IContractNotifier.NotifyAsync()</code> which automatically updates:
                            <em>1) Operations</em> (transit corridors), <em>2) Finance</em> (billing ledger), <em>3) Client Services</em> (client communications), and <em>4) Compliance</em> (auditing).
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Details" asp-route-id="@Model.ContractId" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-glms-primary px-4">
                            <i class="fa-solid fa-paper-plane me-1"></i> Apply & Broadcast Change
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
